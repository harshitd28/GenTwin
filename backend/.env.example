# TwinGuard Dynamics — Telegram Alert System
# Copy to .env and fill in values. Never commit .env.

TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather
TELEGRAM_CHAT_ID=your_chat_id

# Optional: enrich alert narrative with Gemini (falls back to contract SOP if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Alert defaults
PLANT_NAME=JK Cement — Rotary Kiln Line 2
ALERTS_ENABLED=true
